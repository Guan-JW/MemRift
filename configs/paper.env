# Safe baseline. Increase rounds only after validating available unified memory.
# DATASET_REVISION must be set to the exact 40-hex revision pre-populated in CACHE_DIR.
CONTEXT_TOKENS=2048
BATCH_SIZE=1
ROUNDS=7
WARMUP_ROUNDS=1
TIMEOUT_SECONDS=2400
MIN_AVAILABLE_GIB=4
WANDB_MODE=disabled
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
