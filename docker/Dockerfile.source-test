FROM memrift-artifact:0.1.0-review
COPY . /workspace
RUN chmod +x /workspace/docker/entrypoint.sh /workspace/scripts/smoke.sh /workspace/scripts/evaluate.sh
LABEL org.opencontainers.image.title="MemRift source-test image" \
      org.opencontainers.image.revision="unknown-uncommitted" \
      org.opencontainers.image.licenses="Apache-2.0"
