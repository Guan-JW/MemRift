{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrift.invalid/schema/checkpoint-1.0.json",
  "$comment": "index.json is validated against $defs/index; metadata.json is validated against $defs/metadata.",
  "oneOf": [
    {"$ref": "#/$defs/index"},
    {"$ref": "#/$defs/metadata"}
  ],
  "$defs": {
    "index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "file", "shape", "dtype", "scheme"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "stride": {"type": "array", "items": {"type": "integer"}},
          "storage_offset": {"type": "integer", "minimum": 0},
          "dtype": {"type": "string", "minLength": 1},
          "scheme": {"enum": ["split_zstd", "raw_torch"]}
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "format", "model_logical_id", "source_revision", "zstd_level", "tensor_count", "compression_seconds"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "format": {"const": "memrift-float-split-stride-v1"},
        "model_logical_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "zstd_level": {"type": "integer", "minimum": 1, "maximum": 22},
        "tensor_count": {"type": "integer", "minimum": 1},
        "compression_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
