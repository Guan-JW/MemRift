{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memrift.invalid/schema/model-manifest-1.0.json",
  "type": "object",
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "huggingface_id", "revision", "license", "local_mount_path", "expected_files", "expected_bytes", "sha256", "checkpoint_preparation_command", "checkpoint_format", "zstd_level", "checkpoint_payload_sha256"],
        "properties": {
          "logical_name": {"type": "string", "minLength": 1},
          "huggingface_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 1},
          "local_mount_path": {"type": "string", "pattern": "^/models/"},
          "expected_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_bytes": {"type": ["integer", "null"], "minimum": 1},
          "sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "checkpoint_preparation_command": {"type": "string", "minLength": 1},
          "checkpoint_format": {"const": "memrift-float-split-stride-v1"},
          "zstd_level": {"type": "integer", "minimum": 1, "maximum": 22},
          "checkpoint_payload_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
